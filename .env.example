# Copy this file to .env.local and replace the placeholders with the real
# values from the Supabase dashboard: Project Settings > API Keys.
#
# Both of these are safe to expose in browser code. Row-level security does the
# real authorisation, which is why the key is called "publishable".
#
# .env.local is gitignored. This file is not, and must never hold a real value.
#
# The service_role key bypasses RLS entirely. It is not needed anywhere in this
# project. Do not add it here or to .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
